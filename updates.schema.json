{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisflows-home-preview.pages.dev/updates.schema.json",
  "title": "AIS FLOWS public updates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deployment_status", "feed_url", "changelog_url", "updates"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "deployment_status": {"enum": ["local_candidate_not_deployed", "public"]},
    "feed_url": {"type": "string"},
    "changelog_url": {"type": "string"},
    "updates": {"type": "array", "items": {"$ref": "#/$defs/update"}}
  },
  "$defs": {
    "update": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "object_id", "item_id", "change_type", "version", "updated_at", "summary_en", "summary_ru", "content_url", "canonical_url"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "object_id": {"type": "string"}, "item_id": {"type": ["string", "null"]},
        "change_type": {"enum": ["created", "updated", "released", "superseded", "withdrawn"]}, "version": {"type": ["string", "null"]},
        "updated_at": {"type": "string", "format": "date-time"}, "summary_en": {"type": "string"}, "summary_ru": {"type": "string"},
        "content_url": {"type": ["string", "null"]}, "canonical_url": {"type": ["string", "null"]}
      }
    }
  }
}
