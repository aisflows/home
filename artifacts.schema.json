{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisflows.github.io/home/artifacts.schema.json",
  "title": "AIS FLOWS artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deployment_status", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "deployment_status": {"enum": ["local_candidate_not_deployed", "public"]},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner_object_id", "status", "version", "file_name", "content_type", "size_bytes", "sha256", "download_url", "license_url", "published_at", "last_verified"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "owner_object_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "status": {"enum": ["published", "withdrawn"]},
        "version": {"type": "string", "minLength": 1},
        "file_name": {"type": "string", "minLength": 1},
        "content_type": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "number", "exclusiveMinimum": 0},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "download_url": {"type": ["string", "null"]},
        "license_url": {"type": ["string", "null"]},
        "published_at": {"type": "string", "format": "date-time"},
        "last_verified": {"type": "string", "format": "date"}
      }
    }
  }
}
